// @title Ocarina Beat
// @by Jacob Feit Mann


const ocarina =  n("<2 [- 1] - [<3 - >  <4 5 6>] >*4".add(0)).scale("F:major").sound("ocarina")
  .adsr(".05:.4:.7:.6")
  .room(0.3).delay("0.8:0.6:0.6")
const guitar =  n("<2 [- 1] - [<3 - >  <4 5 6>] >*4".add(0)).scale("F:major").sound("gm_electric_guitar_jazz:8")
  .attack(0.05).decay(0.1).sustain(0.3).release(0.6)
  .hard("4:.06")
  .room("0.7:4").delay("0.4:0.4:0.2")
const reese = note("<[f1 a1] [c1@3 e1]>/2").sound("gm_synth_brass_1")
const kickSnare = s("<bd sd>*2").bank("bossdr110").room("0.2:0.3")
const hats = s("hh*2 [hh hh hh] hh*2 <hh [hh [hh hh]]>").bank("bossdr110").gain(0.2).room("0.1:0.1")
const rim = s("- - < - rim >").bank("alesissr16").gain(0.4)
const drums = stack(kickSnare, hats, rim)

$: stack(
  arrange([16, ocarina]),
  arrange([8, silence], [8, reese]),
  arrange([8, silence], [8, drums], [4, silence], [12, kickSnare]),
  arrange([4, silence], [4, guitar]),
)._pianoroll()

